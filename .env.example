# Copia este archivo como .env y completa los valores. El .env NO se sube a GitHub.

# Ticket de la API de Mercado Público (https://www.chilecompra.cl/api/)
MP_TICKET=
# Segundos de espera entre consultas a la API (si aparece el error 429, súbelo)
MP_PAUSA=1.0

# Base de datos (SQLite local; para PostgreSQL: postgresql://usuario:clave@host/radar)
DB_URL=sqlite:///data/radar.db

# LLM local con Ollama
OLLAMA_URL=http://localhost:11434
# Por defecto IBM Granite 4.2 8B. Alternativas: mistral (citas más precisas) o gemma4:e2b (más rápido)
LLM_MODEL=granite4.2:8b
LLM_NUM_CTX=8192
# Modelo solo para leer las bases (más rápido); vacío = LLM_MODEL. Granite sigue para puntaje y preguntas
LLM_MODEL_EXTRACCION=gemma4:e2b
LLM_THINK_EXTRACCION=
# Tope de tokens de la respuesta (entrada + respuesta deben caber en LLM_NUM_CTX)
LLM_NUM_PREDICT=4000
# Modelos con razonamiento (IBM Granite 4.2): false lo desactiva y reduce el tiempo a la mitad.
# Con mistral o gemma4:e2b déjalo vacío (LLM_THINK=)
LLM_THINK=false

# Minutos que quedan cargados los modelos en la GPU después de usarlos (Ollama trae 5)
LLM_KEEP_ALIVE_MINUTOS=30

# Embeddings (ollama pull granite-embedding:278m)
EMBED_MODEL=granite-embedding:278m
# Etapa 1b del filtro por similitud de títulos: desactivada (no mejoró sobre las palabras clave, ver registro S3)
BUSQUEDA_SEMANTICA=false

# Carga de bases desde la carpeta de descargas (opción A). Vacío = la carpeta Descargas del usuario
CARPETA_DESCARGAS=
